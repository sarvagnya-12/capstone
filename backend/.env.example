# Postgres connection string. Local dev matches docker-compose.yml (added Step 4).
DATABASE_URL=postgresql+psycopg://dryrunai:dryrunai@localhost:5432/dryrunai

# JWT auth settings (used starting Step 9). Never commit a real secret here.
# Generate one locally with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-before-any-non-local-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Local filesystem root for uploaded/generated images (used starting Step 11).
# Optional -- defaults to backend/storage/ (an absolute path, resolved from
# config.py's own location so it's correct regardless of the process's working
# directory). Only set this if you want storage somewhere else.
# STORAGE_ROOT=./storage

# Comma-separated list of frontend origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173

# dev | prod  -- controls logging verbosity.
ENVIRONMENT=dev
