# Postgres connection string. Local dev matches docker-compose.yml (added Step 4).
DATABASE_URL=postgresql+psycopg://dryrunai:dryrunai@localhost:5432/dryrunai

# JWT auth settings (used starting Step 9). Never commit a real secret here.
# Generate one locally with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-before-any-non-local-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Local filesystem root for uploaded/generated images (used starting Step 11).
# Optional -- defaults to backend/storage/ (an absolute path, resolved from
# config.py's own location so it's correct regardless of the process's working
# directory). Only set this if you want storage somewhere else.
# STORAGE_ROOT=./storage

# Comma-separated list of frontend origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173

# dev | prod  -- controls logging verbosity.
ENVIRONMENT=dev

# LLM persona engine (used starting Step 20). Provider-agnostic by design --
# set LLM_PROVIDER, then only that provider's own settings matter.
#
# ollama (default): a local open-source model. No API key, no billing, no
#   network calls off this machine. Setup: install from
#   https://ollama.com/download, then `ollama pull llama3.1:8b`.
# anthropic: hosted Claude. Needs a key from https://console.anthropic.com/
#   with its own billing -- a Claude Pro/Max subscription does NOT include API
#   usage. Never commit a real key here.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Hosted Ollama (e.g. Ollama's cloud): point OLLAMA_BASE_URL at it and set its
# key here. Leave empty for a local Ollama. Persona prompts (and images, with
# LLM_VISION) are then sent to that server.
OLLAMA_API_KEY=

# Show personas the actual variant image. Needs a vision-capable model
# (e.g. gemma3:4b fits a 6GB GPU locally; larger ones hosted).
LLM_VISION=false

# Ground persona reactions in real Amazon reviews of similar shoes. Build the
# index first: python -m scripts.build_review_index
REVIEW_GROUNDING_ENABLED=false
REVIEW_GROUNDING_K=5
# REVIEW_INDEX_DIR=storage/review_index

# Variant generator. gan (default) = FastGAN only. hybrid = GAN generates rough
# concepts, a hosted diffusion API refines them into photoreal variants.
# hybrid sends product photos to the IMAGE_PROVIDER's servers and is billed per
# image by that provider. Never commit a real key here.
GENERATOR_BACKEND=gan
# IMAGE_PROVIDER: gemini (paid: needs billing on the key) or cloudflare (free
# daily allowance). For cloudflare, IMAGE_API_KEY is an API token with the
# "Workers AI" permission and CLOUDFLARE_ACCOUNT_ID is from the dashboard.
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
# 1024 = ~85 free images/day on Cloudflare; 512 = ~270/day (pair with SR_ENABLED).
DIFFUSION_OUTPUT_SIZE=1024
DIFFUSION_STRENGTH=0.55
DIFFUSION_INIT=seed
GAN_OVERSAMPLE=3
MAX_API_IMAGES_PER_SIMULATION=24

# ESRGAN upscaler (2x) applied to every generated variant. Needs a trained
# checkpoint: python -m app.ml.sr.train_esrgan (see app/ml/sr/train_esrgan.py).
SR_ENABLED=false
# SR_CHECKPOINT=storage/esrgan/models/shoes512/net_g_ema_050000.pt
# Only upscale variants smaller than this (skips 1024px diffusion output).
SR_TARGET_SIZE=1024
# Hybrid backend: also upscale the GAN concept before sending it to diffusion.
SR_UPSCALE_SEED=true
