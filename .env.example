# Full-stack docker-compose.yml (Step 41). For local dev without Docker
# (running uvicorn/vite directly), use backend/.env and frontend/.env
# instead -- this file is only read by `docker compose up`.

# Postgres container credentials. Must match what DATABASE_URL is built
# from inside docker-compose.yml's backend service.
POSTGRES_USER=dryrunai
POSTGRES_PASSWORD=dryrunai
POSTGRES_DB=dryrunai

# Required, no safe default -- generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Frontend origin the backend accepts CORS requests from. The bundled
# nginx.conf proxies /api same-origin, so this mostly matters if the
# backend's own port (8000) is ever called directly.
CORS_ORIGINS=http://localhost

# dev | prod -- containerized deployments default to prod (Step 41).
ENVIRONMENT=prod

# Optional -- persona-reaction simulation degrades to clearly-marked
# [LLM_ERROR] rows if left unset (Steps 20-21's disclosed, documented gap),
# it does not block the rest of the pipeline.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
