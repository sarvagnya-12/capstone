{
  "service_name": "market_service",
  "collector_plugins": [
    "market_service.collectors.official",
    "market_service.collectors.retail",
    "market_service.collectors.marketplace"
  ],
  "supported_collectors": [
    "nike",
    "adidas",
    "puma",
    "new_balance",
    "asics",
    "zappos",
    "foot_locker",
    "jd_sports",
    "stockx",
    "goat"
