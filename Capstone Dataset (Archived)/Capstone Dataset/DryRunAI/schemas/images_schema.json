{
  "schema_name": "dryrunai_images_schema",
  "schema_version": 1,
  "description": "Global schema contract for image_metadata.csv generated by Service 02 Asset Manager.",
  "columns": [
    {"name": "image_id", "type": "string", "required": true},
    {"name": "product_id", "type": "string", "required": true},
    {"name": "source", "type": "string", "required": false},
    {"name": "source_url", "type": "url", "required": false},
    {"name": "original_image_url", "type": "url", "required": true},
    {"name": "image_type", "type": "string", "required": true},
    {"name": "width", "type": "integer", "required": false},
    {"name": "height", "type": "integer", "required": false},
    {"name": "aspect_ratio", "type": "number", "required": false},
    {"name": "file_size", "type": "integer", "required": false},
    {"name": "sha256", "type": "string", "required": false},
    {"name": "image_format", "type": "string", "required": false},
    {"name": "download_timestamp", "type": "datetime", "required": true},
    {"name": "status", "type": "string", "required": true},
    {"name": "original_filename", "type": "string", "required": false}
  ]
}
