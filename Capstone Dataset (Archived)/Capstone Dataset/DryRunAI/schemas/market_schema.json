{
  "schema_name": "dryrunai_market_schema",
  "schema_version": 1,
  "description": "Global schema contract for market.csv generated by Service 04 Market Service.",
  "columns": [
    {"name": "market_record_id", "type": "string", "required": true},
    {"name": "product_id", "type": "string", "required": true},
    {"name": "source", "type": "string", "required": true},
    {"name": "source_url", "type": "url", "required": false},
    {"name": "market_type", "type": "enum", "required": true},
    {"name": "price_type", "type": "enum", "required": true},
    {"name": "currency", "type": "string", "required": false},
    {"name": "price", "type": "number", "required": false},
    {"name": "availability", "type": "enum", "required": true},
    {"name": "stock_status", "type": "string", "required": false},
    {"name": "release_date", "type": "date", "required": false},
    {"name": "region", "type": "string", "required": false},
    {"name": "last_updated", "type": "datetime", "required": true},
    {"name": "status", "type": "string", "required": true}
  ],
  "enums": {
    "market_type": ["Official", "Retail", "Marketplace", "Resale", "Outlet", "Distributor"],
    "price_type": ["MSRP", "Retail", "Discount", "Outlet", "Marketplace", "Resale"],
    "availability": ["Available", "Limited", "OutOfStock", "Discontinued", "Unknown"]
  }
}
