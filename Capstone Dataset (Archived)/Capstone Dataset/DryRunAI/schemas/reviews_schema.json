{
  "schema_name": "dryrunai_reviews_schema",
  "schema_version": 1,
  "description": "Global schema contract for reviews.csv generated by Service 03 Review Builder.",
  "columns": [
    {"name": "review_id", "type": "string", "required": true},
    {"name": "product_id", "type": "string", "required": true},
    {"name": "source", "type": "string", "required": true},
    {"name": "source_url", "type": "url", "required": false},
    {"name": "source_review_id", "type": "string", "required": false},
    {"name": "review_title", "type": "string", "required": false},
    {"name": "review_text", "type": "string", "required": true},
    {"name": "rating", "type": "number", "required": true},
    {"name": "review_date", "type": "date", "required": false},
    {"name": "reviewer_name", "type": "string", "required": false},
    {"name": "verified_purchase", "type": "boolean", "required": false},
    {"name": "helpful_votes", "type": "integer", "required": false},
    {"name": "language", "type": "string", "required": true},
    {"name": "collected_at", "type": "datetime", "required": true},
    {"name": "status", "type": "string", "required": true}
  ]
}
